import random
import self.grid
import self.view

effect fn order(pool: List[Int], acc: List[Int]) -> List[Int] =
  if list.is_empty(pool) then acc
  else {
    let i = random.int(0, list.len(pool) - 1)
    order(list.remove_at(pool, i), acc + [list.get(pool, i) ?? 0])!
  }

effect fn step(x: Int, y: Int, ds: List[Int],
               m: grid.Maze) -> grid.Maze =
  if list.is_empty(ds) then m
  else {
    let d = list.first(ds) ?? 0
    let nb = grid.ahead(x, y, d)
    let rest = list.drop(ds, 1)
    if grid.at(m, nb.0, nb.1) != 0 then step(x, y, rest, m)!
    else {
      let seen = grid.mark(m, nb.0, nb.1, grid.back(d))
      step(x, y, rest, carve(nb.0, nb.1, seen)!)!
    }
  }

effect fn carve(x: Int, y: Int, m: grid.Maze) -> grid.Maze =
  step(x, y, order([1, 2, 3, 4], [])!, m)!

effect fn main() -> Unit = {
  let start = grid.mark(grid.blank(), 0, 0, 5)
  println(view.doc(carve(0, 0, start)!))
}
