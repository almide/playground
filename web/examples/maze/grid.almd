type Maze = List[Int]

let N = 17
let DX = [0, 1, 0, -1]
let DY = [-1, 0, 1, 0]

fn back(d: Int) -> Int = if d <= 2 then d + 2 else d - 2

fn ahead(x: Int, y: Int, d: Int) -> (Int, Int) =
  (x + (list.get(DX, d - 1) ?? 0), y + (list.get(DY, d - 1) ?? 0))

fn blank() -> Maze = list.repeat(0, N * N)

fn at(m: Maze, x: Int, y: Int) -> Int =
  if x < 0 or y < 0 or x >= N or y >= N then -1
  else list.get(m, y * N + x) ?? 0

fn mark(m: Maze, x: Int, y: Int, d: Int) -> Maze =
  list.set(m, y * N + x, d)

fn parent(m: Maze, p: (Int, Int)) -> (Int, Int) =
  ahead(p.0, p.1, at(m, p.0, p.1))

fn gate(x: Int, y: Int) -> Bool =
  (x == 0 and y == 0) or (x == N - 1 and y == N)

fn wall_n(m: Maze, x: Int, y: Int) -> Bool =
  not (at(m, x, y) == 1 or at(m, x, y - 1) == 3 or gate(x, y))

fn wall_w(m: Maze, x: Int, y: Int) -> Bool =
  not (at(m, x, y) == 4 or at(m, x - 1, y) == 2)
