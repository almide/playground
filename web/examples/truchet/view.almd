let NS = "http://www.w3.org/2000/svg"
let INK = "fill='none' stroke='#243040' stroke-width='.18'"

fn arc(a: (Int, Int), b: (Int, Int)) -> String = {
  let p = "${int.to_string(a.0)} ${int.to_string(a.1)}"
  let q = "${int.to_string(b.0)} ${int.to_string(b.1)}"
  "M${p} A1 1 0 0 1 ${q}"
}

fn doc(side: Int, d: String) -> String = {
  let s = int.to_string(side)
  """
  <svg xmlns='${NS}' viewBox='0 0 ${s} ${s}'>
  <rect width='${s}' height='${s}' fill='#efe9dc'/>
  <g ${INK} stroke-linecap='round'>
    <path d='${d}'/>
  </g>
  </svg>
  """
}
