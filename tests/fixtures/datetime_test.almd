effect fn main() -> Result[Unit, String] = {
  // 2024-01-15 12:30:00 UTC
  let ts = datetime.from_parts(2024, 1, 15, 12, 30, 0)
  assert_eq(datetime.year(ts), 2024)
  assert_eq(datetime.month(ts), 1)
  assert_eq(datetime.day(ts), 15)
  assert_eq(datetime.hour(ts), 12)
  assert_eq(datetime.minute(ts), 30)
  assert_eq(datetime.second(ts), 0)
  assert_eq(datetime.to_iso(ts), "2024-01-15T12:30:00Z")

  // roundtrip
  let ts2 = datetime.from_parts(2000, 6, 15, 0, 0, 0)
  assert_eq(datetime.to_iso(ts2), "2000-06-15T00:00:00Z")

  println("datetime: ok")
}
