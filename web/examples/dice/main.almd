// Dice — the face falls out of the number
//
// A die is symmetric, so no table of six layouts is needed: the diagonal
// pair shows from 2, the other corners from 4, the sides only on 6, and the
// centre pip whenever the number is odd. Three rows, and the source lays
// out like the die itself.

import random

fn pip(on: Bool) -> String = if on then "●" else " "

fn face(n: Int) -> List[String] = [
  "${pip(n >= 2)}   ${pip(n >= 4)}",
  "${pip(n == 6)} ${pip(n % 2 == 1)} ${pip(n == 6)}",
  "${pip(n >= 4)}   ${pip(n >= 2)}",
]

effect fn main() -> Unit = {
  let n = random.int(1, 6)
  println("╭───────╮")
  for row in face(n) {
    println("│ ${row} │")
  }
  println("╰───────╯")
  println("  you rolled ${int.to_string(n)}")
}
