{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Almide",
  "scopeName": "source.almide",
  "fileTypes": ["almd"],
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#number" },
    { "include": "#keyword" },
    { "include": "#type" },
    { "include": "#function-def" },
    { "include": "#constant" },
    { "include": "#operator" },
    { "include": "#identifier" }
  ],
  "repository": {
    "comment": {
      "patterns": [
        { "name": "comment.line.double-slash.almide", "match": "//.*$" },
        { "name": "comment.block.almide", "begin": "/\\*", "end": "\\*/", "patterns": [] }
      ]
    },
    "string": {
      "patterns": [
        { "name": "string.quoted.triple.almide", "begin": "r\"\"\"", "end": "\"\"\"", "patterns": [] },
        { "name": "string.quoted.triple.almide", "begin": "\"\"\"", "end": "\"\"\"", "patterns": [{ "include": "#string-interpolation" }, { "include": "#string-escape" }] },
        { "name": "string.quoted.double.raw.almide", "begin": "r\"", "end": "\"", "patterns": [] },
        { "name": "string.quoted.single.almide", "begin": "'", "end": "'", "patterns": [{ "include": "#string-escape" }] },
        { "name": "string.quoted.double.almide", "begin": "\"", "end": "\"", "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.almide" } }, "endCaptures": { "0": { "name": "punctuation.definition.string.end.almide" } }, "patterns": [{ "include": "#string-interpolation" }, { "include": "#string-escape" }] }
      ]
    },
    "number": {
      "patterns": [
        { "name": "constant.numeric.hex.almide", "match": "\\b0[xX][0-9a-fA-F_]+\\b" },
        { "name": "constant.numeric.float.almide", "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9_]+)?\\b" },
        { "name": "constant.numeric.scientific.almide", "match": "\\b[0-9][0-9_]*[eE][+-]?[0-9_]+\\b" },
        { "name": "constant.numeric.integer.almide", "match": "\\b[0-9][0-9_]*\\b" }
      ]
    },
    "keyword": {
      "patterns": [
        { "name": "keyword.control.almide", "match": "\\b(if|then|else|match|for|in|while|guard)\\b" },
        { "name": "keyword.declaration.almide", "match": "\\b(fn|type|protocol|let|var|test|import|module)\\b" },
        { "name": "storage.modifier.almide", "match": "\\b(pub|local|mod|effect|strict|mut)\\b" },
        { "name": "constant.language.almide", "match": "\\b(true|false|none|some|ok|err|todo|not|and|or)\\b" },
        { "name": "keyword.control.flow.almide", "match": "\\b(break|continue|fan)\\b" },
        { "name": "keyword.other.annotation.almide", "match": "@[a-z_][a-zA-Z0-9_]*" }
      ]
    },
    "constant": {
      "patterns": [
        { "name": "constant.language.boolean.almide", "match": "\\b(true|false)\\b" },
        { "name": "constant.language.option.almide", "match": "\\b(some|none)\\b" },
        { "name": "constant.language.result.almide", "match": "\\b(ok|err)\\b" },
        { "name": "constant.language.almide", "match": "\\b(Ok|Err|Some|None)\\b" },
        { "name": "keyword.other.todo.almide", "match": "\\b(todo)\\b" }
      ]
    },
    "type": {
      "patterns": [
        { "name": "support.type.builtin.almide", "match": "\\b(Int|Float|String|Bool|Unit|Path|List|Map|Set|Option|Result|Bytes|Matrix|Json|IoError)\\b" },
        { "name": "entity.name.type.almide", "match": "\\b[A-Z][a-zA-Z0-9_]*\\b" }
      ]
    },
    "operator": {
      "patterns": [
        { "name": "keyword.operator.arrow.almide", "match": "->|=>" },
        { "name": "keyword.operator.pipe.almide", "match": "\\|>" },
        { "name": "keyword.operator.compose.almide", "match": ">>" },
        { "name": "keyword.operator.unwrap.almide", "match": "\\?\\?|\\?\\.|!|\\?" },
        { "name": "keyword.operator.range.almide", "match": "\\.\\.=|\\.\\.\\.|\\.\\." },
        { "name": "keyword.operator.comparison.almide", "match": "==|!=|<=|>=|<|>" },
        { "name": "keyword.operator.assignment.almide", "match": "=" },
        { "name": "keyword.operator.arithmetic.almide", "match": "\\*\\*|[+\\-*/%^]" }
      ]
    },
    "identifier": {
      "patterns": [
        { "name": "support.function.builtin.almide", "match": "\\b(println|eprintln|assert_eq|assert_ne|assert|unwrap_or)\\b" },
        { "name": "support.module.almide", "match": "\\b(string|list|map|set|int|float|math|datetime|error|value|bytes|matrix|option|result|prim|fs|env|process|io|json|random|regex|testing|log|path|args|http|net|zlib|base64|hex|html|mem)\\b(?=\\.)" },
        { "name": "variable.language.almide", "match": "\\b(self|_)\\b" },
        { "name": "entity.name.function.predicate.almide", "match": "\\b[a-z_][a-zA-Z0-9_]*\\?" },
        { "name": "variable.other.almide", "match": "\\b[a-z_][a-zA-Z0-9_]*\\b" }
      ]
    },
    "string-interpolation": { "name": "meta.interpolation.almide", "begin": "\\$\\{", "end": "\\}", "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.almide" } }, "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.almide" } }, "contentName": "source.almide.embedded", "patterns": [{ "include": "source.almide" }] },
    "string-escape": { "name": "constant.character.escape.almide", "match": "\\\\[ntr0\\\\\"$]|\\\\u\\{[0-9a-fA-F]+\\}" },
    "function-def": { "name": "meta.function.almide", "match": "\\b(fn)\\s+([a-z_][a-zA-Z0-9_]*\\??)", "captures": { "1": { "name": "keyword.declaration.almide" }, "2": { "name": "entity.name.function.almide" } } }
  }
}
