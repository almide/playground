// This tab is the `gold` module — what the metal looks like.
//
// A struck coin is all shading: the mark is the same metal as the field, so
// `strike` draws the shape three times — shadow down-right, highlight up-left,
// then the metal itself. Two field gradients give the two sides their finishes:
// `pol` is polished, `sat` is satin.

let DARK = "fill='#7d5411' opacity='.55'"
let LITE = "fill='#fff6d8' opacity='.75'"

let DEFS = """
  <linearGradient id='rim' x1='.16' x2='.84' y2='1'>
    <stop offset='0' stop-color='#fff3cd'/>
    <stop offset='.35' stop-color='#a5711a'/>
    <stop offset='.7' stop-color='#e6b544'/>
    <stop offset='1' stop-color='#7a5111'/>
  </linearGradient>
  <radialGradient id='pol' cx='.34' cy='.28' r='.88'>
    <stop offset='0' stop-color='#fff6d6'/>
    <stop offset='.5' stop-color='#f0c94f'/>
    <stop offset='1' stop-color='#b8851e'/>
  </radialGradient>
  <radialGradient id='sat' cx='.42' cy='.38' r='.9'>
    <stop offset='0' stop-color='#e9d29a'/>
    <stop offset='.55' stop-color='#cfa63c'/>
    <stop offset='1' stop-color='#9e7621'/>
  </radialGradient>
"""

fn strike(s: String) -> String = """
  <g transform='translate(.8 .9)' ${DARK}>${s}</g>
  <g transform='translate(-.6 -.7)' ${LITE}>${s}</g>
  <g fill='#d9a736'>${s}</g>
"""
