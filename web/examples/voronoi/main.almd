import string
import self.cell
import self.glass

let W = 300
let H = 300
let SCALE = 8.0

fn pixel(py: Int, px: Int, row: String) -> String =
  if px >= W then row
  else {
    let x = float.from(px) / float.from(W) * SCALE
    let y = float.from(py) / float.from(H) * SCALE
    let r = cell.near(x, y)
    let k = glass.light(r.0)
    let c = glass.dim(r.1, k)
    pixel(py, px + 1, row + c + " ")
  }

fn rows(py: Int) -> Unit =
  if py >= H then ()
  else {
    println(string.trim(pixel(py, 0, "")))
    rows(py + 1)
  }

fn main() -> Unit = {
  println("P3")
  println("${int.to_string(W)} ${int.to_string(H)}")
  println("255")
  rows(0)
}
