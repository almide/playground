import regex

effect fn main() -> Result[Unit, String] = {
  assert(regex.is_match(regex.new(r"\d+"), "abc123"))
  assert(regex.full_match(regex.new(r"\d+"), "123"))
  assert(not regex.full_match(regex.new(r"\d+"), "abc123"))
  assert_eq(regex.find(regex.new(r"\d+"), "abc123def"), some("123"))
  assert_eq(regex.find_all(regex.new(r"\d+"), "a1b22c333"), ["1", "22", "333"])
  assert_eq(regex.replace(regex.new(r"\d"), "a1b2c3", "X"), "aXbXcX")
  assert_eq(regex.replace_first(regex.new(r"\d"), "a1b2c3", "X"), "aXb2c3")
  assert_eq(regex.split(regex.new(r",\s*"), "a, b,c, d"), ["a", "b", "c", "d"])
  assert_eq(regex.captures(regex.new(r"(\d{4})-(\d{2})-(\d{2})"), "2026-03-09"), some([some("2026-03-09"), some("2026"), some("03"), some("09")]))
  println("regex: ok")
}
