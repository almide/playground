effect fn main() -> Result[Unit, String] = {
  assert_eq(float.to_string(3.14), "3.14")
  assert_eq(int.from_saturating(3.7), 3)
  assert_eq(int.from_saturating(-2.9), -2)
  assert_eq(float.round(2.5), 3.0)
  assert_eq(float.floor(2.9), 2.0)
  assert_eq(float.ceil(2.1), 3.0)
  assert_eq(float.abs(-5.0), 5.0)
  assert_eq(math.sqrt(4.0), 2.0)
  assert_eq(float.parse("3.14") ?? 0.0, 3.14)
  assert_eq(float.from(42), 42.0)
  println("float: ok")
}
