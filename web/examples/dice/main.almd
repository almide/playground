import random

let FACES = [
  ["     ", "  ●  ", "     "],
  ["●    ", "     ", "    ●"],
  ["●    ", "  ●  ", "    ●"],
  ["●   ●", "     ", "●   ●"],
  ["●   ●", "  ●  ", "●   ●"],
  ["●   ●", "●   ●", "●   ●"],
]

effect fn main() -> Unit = {
  let n = random.int(1, 6)
  let face = list.get(FACES, n - 1)!
  println("╭───────╮")
  for row in face {
    println("│ ${row} │")
  }
  println("╰───────╯")
  println("  you rolled ${int.to_string(n)}")
}
