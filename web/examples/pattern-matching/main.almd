type Shape =
  | Circle(Float)
  | Rect(Float, Float)
  | Triangle(Float, Float)

fn area(s: Shape) -> Float =
  match s {
    Circle(r) => 3.14159265 * r * r
    Rect(w, h) => w * h
    Triangle(b, h) => 0.5 * b * h
  }

fn describe(s: Shape) -> String =
  match s {
    Circle(r) => "circle r=${float.to_string(r)}"
    Rect(w, h) => "rect ${float.to_string(w)}x${float.to_string(h)}"
    Triangle(b, h) => "triangle b=${float.to_string(b)} h=${float.to_string(h)}"
  }

fn main() -> Unit = {
  let shapes = [Circle(1.0), Rect(3.0, 4.0), Triangle(6.0, 2.0)]
  for s in shapes {
    println("${describe(s)} -> area ${float.to_string(area(s))}")
  }
}
