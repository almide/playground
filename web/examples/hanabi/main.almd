// Hanabi — summer fireworks as generative SVG
//
// `import self.spark` loads the spark.almd tab as a module. Each run
// picks a new hue and a new number of rays, so no two flowers are alike.
// Print an <svg> document and the Visual tab renders it.

import random
import self.spark

effect fn main() -> Unit = {
  let hue = int.to_string(random.int(0, 359))
  let n = random.int(22, 34)
  let step = 6.2832 / int.to_float(n)
  let art = list.range(0, n * 7)
    |> list.map((i) => spark.at(i, step))
    |> list.join("")
  let g = "<g fill='hsl(${hue},95%,68%)'>${art}</g>"
  let head = "<svg xmlns='http://www.w3.org/2000/svg'"
  println("${head} viewBox='0 0 400 400'>${g}</svg>")
}
