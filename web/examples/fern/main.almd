import bytes
import random
import self.ifs
import self.ppm

let W = 300
let H = 400

effect fn walk(mut buf: Bytes, n: Int) -> Unit = {
  var x = 0.0
  var y = 0.0
  for _ in 0..<n {
    let p = ifs.step(x, y, random.float())
    let px = int.from_saturating(float.floor((p.0 + 3.05) * 51.0))
    let py = H - 12 - int.from_saturating(float.floor(p.1 * 37.5))
    if px >= 0 and px < W and py >= 0 and py < H then {
      let j = py * W + px
      let c = bytes.get(buf, j) ?? 0
      if c < 255 then bytes.put_u8(buf, j, c + 1)
    }
    x = p.0
    y = p.1
  }
}

effect fn main() -> Unit = {
  var buf = bytes.zeros(W * H)
  walk(buf, 500000)!
  ppm.emit(buf, W, H)
}
